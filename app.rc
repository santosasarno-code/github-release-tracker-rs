
1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEOS 0x4
 FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "santosasarno-code"
      VALUE "FileDescription", "GitHub Release Tracker"
      VALUE "FileVersion", "2.0.0"
      VALUE "InternalName", "GitHubReleaseTracker"
      VALUE "OriginalFilename", "GitHubReleaseTracker.exe"
      VALUE "ProductName", "GitHub Release Tracker"
      VALUE "ProductVersion", "2.0.0"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
